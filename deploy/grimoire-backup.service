# systemd USER service: daily verified backup, retaining the most recent 14.
# Installed by scripts/install_timers.sh. Logs: data/logs/grimoire-backup.log
[Unit]
Description=Grimoire daily backup

[Service]
Type=oneshot
WorkingDirectory=/home/adyu/apps/grimoire
EnvironmentFile=-/home/adyu/apps/grimoire/.env
ExecStart=/home/adyu/apps/grimoire/.venv/bin/python -m grimoire.backup backup --retain 14
StandardOutput=append:/home/adyu/apps/grimoire/data/logs/grimoire-backup.log
StandardError=append:/home/adyu/apps/grimoire/data/logs/grimoire-backup.log
