# systemd USER service: weekly compaction (merge clusters, refresh project context).
# Installed by scripts/install_timers.sh. Logs: data/logs/grimoire-compact.log
[Unit]
Description=Grimoire weekly compaction

[Service]
Type=oneshot
WorkingDirectory=/home/adyu/apps/grimoire
EnvironmentFile=-/home/adyu/apps/grimoire/.env
ExecStart=/home/adyu/apps/grimoire/.venv/bin/python scripts/compact.py
StandardOutput=append:/home/adyu/apps/grimoire/data/logs/grimoire-compact.log
StandardError=append:/home/adyu/apps/grimoire/data/logs/grimoire-compact.log
